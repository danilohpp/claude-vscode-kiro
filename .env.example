# Claude Code Environment Variables
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_EFFORT=xhigh

# Development
NODE_ENV=development
EDITOR=code

# Kiro/Project
KIRO_ENV=development
KIRO_API_URL=http://localhost:3000
KIRO_API_KEY=seu_api_key

# GitHub
GITHUB_TOKEN=ghp_seu_token
GITHUB_USER=seu_usuario
GITHUB_REPO=claude-vb-kiro

# VPS/Deployment
VPS_HOST=app.seu-servidor.com.br
VPS_USER=seu_usuario
VPS_PORT=22
VPS_DEPLOY_PATH=/opt/seu-app

# Database
DATABASE_URL=postgres://user:password@localhost:5432/seu_db

# API Services
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Port
PORT=3000
DEBUG=false
